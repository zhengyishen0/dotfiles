#!/bin/sh

# nnn custom opener

# Helper: open in hx with preview toggle
open_in_hx() {
    nnn_parent="${NNN_FIFO#*.}"
    fifopid="${TMPDIR:-/tmp}nnn-preview-tui-fifopid.$nnn_parent"
    # Only toggle off if preview is actually running
    if [ -f "$fifopid" ]; then
        preview_was_running=1
        saved_split="$(cat "${TMPDIR:-/tmp}nnn-preview-tui-split.$nnn_parent" 2>/dev/null)"
        "$HOME/.config/nnn/plugins/preview-tui" "$1" 2>/dev/null
    else
        preview_was_running=0
    fi
    hx "$1"
    # Only toggle back on if preview was running before
    if [ "$preview_was_running" = "1" ]; then
        "$HOME/.config/nnn/plugins/preview-tui" "$1" 2>/dev/null
    fi
}

case "$1" in
    # Text/code files - open in helix
    *.txt|*.md|*.json|*.yaml|*.yml|*.toml|*.sh|*.bash|*.zsh|*.nu|\
    *.py|*.js|*.ts|*.jsx|*.tsx|*.rs|*.go|*.c|*.h|*.cpp|*.hpp|\
    *.html|*.css|*.scss|*.lua|*.vim|*.conf|*.ini|*.cfg|*.env|\
    *.gitignore|*.dockerfile|Dockerfile|Makefile|*.mk|\
    *.java|*.swift|*.ex|*.exs|*.rb|*.php|*.sql|*.graphql|*.xml|\
    *.nix|*.zig|*.kt|*.scala|*.clj|*.hs|*.ml|*.el|*.lisp|\
    *.r|*.R|*.jl|*.dart|*.v|*.nim|*.cr|*.groovy|*.gradle)
        open_in_hx "$1" ;;
    
    # Images - preview with macOS
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.svg|*.bmp|*.ico|*.tiff)
        open -a Preview "$1" ;;
    
    # PDF - preview with macOS
    *.pdf)
        open -a Preview "$1" ;;
    
    # Videos/Audio
    *.mp4|*.mkv|*.avi|*.mov|*.webm|*.mp3|*.wav|*.flac|*.m4a)
        open "$1" ;;
    
    # Archives - list contents
    *.zip|*.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tar.xz|*.7z|*.rar)
        open "$1" ;;
    
    # Default - use hx if it is a text file, else system opener
    *)
        if file --mime-type "$1" | grep -q "text/"; then
            open_in_hx "$1"
        else
            open "$1"
        fi ;;
esac
