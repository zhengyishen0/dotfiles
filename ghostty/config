font-family = JetBrains Mono
font-style = Medium
font-size = 14
macos-option-as-alt = true

# Tokyo Night theme with transparency
theme = TokyoNight
background-opacity = 0.95
background-blur-radius = 30

# Window
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
confirm-close-surface = false
copy-on-select = true

# Session restore
window-save-state = always
undo-timeout = 1h
keybind = super+shift+r=redo

# Ghostty tab / window management
keybind = super+shift+w=close_window
keybind = super+shift+nine=move_tab:-1
keybind = super+shift+zero=move_tab:1

# Alt+arrow → word-jump in zsh / pane focus in Zellij
keybind = alt+left=text:\x1b[1;3D
keybind = alt+right=text:\x1b[1;3C

# initial-command = /opt/homebrew/bin/zellij attach --create main
