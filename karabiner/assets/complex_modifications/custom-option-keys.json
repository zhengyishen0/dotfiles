{
  "title": "Custom Option Key Shortcuts",
  "rules": [
    {
      "description": "Right Option + letter opens apps (SANWA BT51)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "product_id": 28705, "vendor_id": 1256 }]
            }
          ],
          "from": {
            "key_code": "w",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [{ "shell_command": "open -a 'WeChat'" }]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "product_id": 28705, "vendor_id": 1256 }]
            }
          ],
          "from": {
            "key_code": "v",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [{ "shell_command": "open -a 'Visual Studio Code'" }]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "product_id": 28705, "vendor_id": 1256 }]
            }
          ],
          "from": {
            "key_code": "c",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [{ "shell_command": "open -a 'Google Chrome'" }]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "product_id": 28705, "vendor_id": 1256 }]
            }
          ],
          "from": {
            "key_code": "g",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [{ "shell_command": "open -a 'Ghostty'" }]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "product_id": 28705, "vendor_id": 1256 }]
            }
          ],
          "from": {
            "key_code": "f",
            "modifiers": { "mandatory": ["right_option"] }
          },
          "to": [{ "shell_command": "open -a 'Lark'" }]
        }
      ]
    },
    {
      "description": "Option+Up/Down to 5 lines in WeChat/Feishu",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "up_arrow",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            { "key_code": "up_arrow" },
            { "key_code": "up_arrow" },
            { "key_code": "up_arrow" },
            { "key_code": "up_arrow" },
            { "key_code": "up_arrow" }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.tencent.xinWeChat", "com.electron.lark"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "down_arrow",
            "modifiers": { "mandatory": ["option"] }
          },
          "to": [
            { "key_code": "down_arrow" },
            { "key_code": "down_arrow" },
            { "key_code": "down_arrow" },
            { "key_code": "down_arrow" },
            { "key_code": "down_arrow" }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": ["com.tencent.xinWeChat", "com.electron.lark"]
            }
          ]
        }
      ]
    }
  ]
}
