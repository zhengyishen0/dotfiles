cask "visual-studio-code"
cask "ghostty"            # Terminal
cask "wezterm"            # Terminal
cask "google-chrome"      # Browser
cask "chromium"           # Browser for automation
cask "google-chrome@canary"

# ==============================================================================
# Casks - AI & Productivity
# ==============================================================================
cask "claude-code"        # Claude CLI

# ==============================================================================
# Casks - System Utilities
# ==============================================================================
cask "maccy"              # Clipboard manager
cask "shottr"             # Screenshot tool
cask "jordanbaird-ice"    # Menu bar management
cask "homerow"            # Keyboard navigation
cask "swish"              # Trackpad gestures
cask "karabiner-elements" # Keyboard customization
cask "clop"               # Image/video optimizer
cask "music-decoy"        # Prevent Music.app auto-launch
cask "pronotes"           # Notes

