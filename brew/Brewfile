# Brewfile - Personal Development Environment
# Install: brew bundle install --file=~/dotfiles/brew/Brewfile
# Check:   brew bundle check --file=~/dotfiles/brew/Brewfile

# ==============================================================================
# Taps
# ==============================================================================
tap "anthropics/claude"

# ==============================================================================
# Zsh Enhancements
# ==============================================================================
brew "oh-my-posh"                     # Prompt (transient prompt support)
brew "zsh-autosuggestions"           # Fish-like suggestions
brew "zsh-autopair"                  # Auto-close brackets/quotes
brew "zsh-history-substring-search"  # History search with up/down
brew "zsh-syntax-highlighting"       # Command highlighting

# ==============================================================================
# Shell
# ==============================================================================
brew "nushell"                        # Structured data shell

# ==============================================================================
# Editors
# ==============================================================================
brew "helix"              # Modal editor (config: ~/.config/helix -> ~/dotfiles/helix)

# ==============================================================================
# Core Tools
# ==============================================================================
brew "git"
brew "git-lfs"
brew "stow"               # Dotfile management
brew "tmux"               # Terminal multiplexer

# ==============================================================================
# Modern CLI Replacements
# ==============================================================================
# File Navigation & Search
brew "fd"                 # Better find
brew "fzf"                # Fuzzy finder (needs: source <(fzf --zsh))
brew "eza"                # Better ls
brew "zoxide"             # Smart cd (needs: eval "$(zoxide init zsh)")
brew "yazi"               # Terminal file manager

# Text & Viewing
brew "bat"                # Better cat
brew "jaq"                # jq alternative in Rust
brew "yq"                 # YAML processor
brew "sd"                 # Better sed
brew "hexyl"              # Hex viewer

# System Monitoring
brew "btop"               # Better top
brew "procs"              # Better ps
brew "duf"                # Better df
brew "dust"               # Better du

# ==============================================================================
# Development Tools
# ==============================================================================
brew "gh"                 # GitHub CLI
brew "git-delta"          # Better git diff
brew "git-graph"          # Git graph visualization
brew "lazygit"            # Git TUI
brew "just"               # Command runner
brew "tokei"              # Code line counter
brew "entr"               # Run on file change
brew "watchexec"          # Run on file change (alternative)
brew "fswatch"            # File system watcher (for world daemon)

# ==============================================================================
# Network & HTTP
# ==============================================================================
brew "httpie"             # User-friendly curl
brew "xh"                 # Fast httpie alternative
brew "gping"              # Ping with graph
brew "privoxy"            # HTTP proxy
brew "shadowsocks-libev"  # Proxy

# ==============================================================================
# Language Runtimes
# ==============================================================================
brew "node@18"            # Node.js LTS
brew "openjdk@17"         # Java 17 LTS (universal default)
brew "pipx"               # Python app installer
brew "uv"                 # Fast Python package manager

# ==============================================================================
# Media & Misc
# ==============================================================================
brew "ffmpeg"             # Media processing
brew "sox"                # Audio processing
brew "whisperkit-cli"     # Speech recognition
brew "cmake"              # Build system
brew "create-dmg"         # Create DMG files
brew "sevenzip"           # 7z compression

# ==============================================================================
# Utilities
# ==============================================================================
brew "tree"               # Directory tree
brew "cheat"              # Cheatsheets
brew "tealdeer"           # tldr pages
brew "lnav"               # Log navigator
brew "xsv"                # CSV toolkit
brew "choose"             # cut/awk alternative
brew "superfile"          # File manager TUI
brew "zellij"             # Terminal workspace

# ==============================================================================
