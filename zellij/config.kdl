// Zellij — near-default config.
// Only changes vs stock: free Alt i/o/n/p for Helix (tree-sitter select),
// Alt-Space = new pane, Alt-x = close pane. Everything else is default, so the on-screen
// keybinding ribbon stays accurate.

keybinds {
    shared_except "locked" {
        unbind "Alt i"
        unbind "Alt o"
        unbind "Alt n"
        unbind "Alt p"
        bind "Alt x" { CloseFocus; }
        bind "Alt e" {
            LaunchOrFocusPlugin "zellij:strider" {
                floating true
            }
        }
    }
    // Alt-Space = global new pane, but NOT in pane mode (so Ctrl-p's ribbon shows "n")
    shared_except "locked" "pane" {
        bind "Alt Space" { NewPane; }
    }
}

theme "catppuccin-mocha"
