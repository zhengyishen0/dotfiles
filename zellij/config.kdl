// Zellij — near-default. Only changes:
//   1. free Alt i/o/n/p for Helix (tree-sitter select)
//   2. catppuccin theme
// Everything else is stock defaults, so the on-screen keybinding ribbon stays honest.

keybinds {
    shared_except "locked" {
        unbind "Alt i"
        unbind "Alt o"
        unbind "Alt n"
        unbind "Alt p"
    }
}

theme "catppuccin-mocha"
